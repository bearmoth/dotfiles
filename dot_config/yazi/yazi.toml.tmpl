[manager]
show_hidden = false
sort_by = "alphabetical"
sort_sensitive = false
sort_reverse = false
sort_dir_first = true
show_symlink = true

[preview]
max_width = 600
max_height = 900

[opener]
edit = [
    { run = 'nvim "$@"', block = true },
]
open = [
{{ if eq .chezmoi.os "darwin" -}}
    { run = 'open "$@"', orphan = true },
{{ else -}}
    { run = 'xdg-open "$@"', orphan = true },
{{ end -}}
]

[open]
rules = [
    { mime = "text/*", use = "edit" },
    { mime = "image/*", use = "open" },
    { mime = "application/pdf", use = "open" },
    { mime = "*", use = "open" },
]
