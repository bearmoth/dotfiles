# ComfyUI as an on-demand user service (managed by chezmoi). Use
# `comfyui start` / `comfyui stop`. There is deliberately no [Install]
# section: the unit is "static" and cannot be enabled, so it never starts at
# login/boot — it holds VRAM and keeps the NVIDIA dGPU awake.
[Unit]
Description=ComfyUI (http://127.0.0.1:8188)
After=network.target

[Service]
ExecStart=%h/.local/bin/comfyui run
Restart=on-failure
RestartSec=5
