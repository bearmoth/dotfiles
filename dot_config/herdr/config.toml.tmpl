[terminal]
default_shell = "fish"
shell_mode = "auto"

[ui.sound]
enabled = false

[ui.toast]
delivery = "herdr"

[ui]
show_agent_labels_on_pane_borders = false

[keys]
# Hyper is the single "herdr modifier" — pane, tab, workspace, and agent
# actions all live here (ctrl+alt+super, see dot_config/ghostty/config.tmpl).
# Collapsing what used to be split across Hyper/Cmd/Alt removes the
# cognitive cost of remembering which layer a given herdr action was on;
# Cmd/Alt on the OS side goes back to being purely Ghostty/system-native.
# Since Hyper is the identical chord on both OSes, none of these need
# per-OS templating. Only truly occasional actions (goto, toggle_sidebar,
# rename_workspace's sibling close_tab, worktrees, etc.) stay on herdr's
# default prefix (ctrl+b) bindings — see the frequency line in
# docs/keybindings.md.
focus_pane_left = "ctrl+alt+super+h"
focus_pane_down = "ctrl+alt+super+j"
focus_pane_up = "ctrl+alt+super+k"
focus_pane_right = "ctrl+alt+super+l"
split_horizontal = "ctrl+alt+super+minus"
split_vertical = "ctrl+alt+super+backslash"
close_pane = "ctrl+alt+super+w"
resize_mode = "ctrl+alt+super+r"
zoom = "ctrl+alt+super+z"

# Swap panes — Hyper+Shift layer of the hjkl nav bindings. swap_pane_* are
# valid config keys despite being absent from `herdr --default-config`
# (found in the binary's TOML field list; reload-config accepts them).
swap_pane_left = "ctrl+alt+shift+super+h"
swap_pane_down = "ctrl+alt+shift+super+j"
swap_pane_up = "ctrl+alt+shift+super+k"
swap_pane_right = "ctrl+alt+shift+super+l"

# Tabs. close_tab is deliberately NOT bound here — closing a tab's last
# pane already auto-closes the tab (verified via herdr pane/tab API
# 2026-07-14), so Hyper+w covers the common case one pane at a time. A
# dedicated one-shot "nuke this whole tab" stays on herdr's own default
# prefix+shift+x, as the escape hatch for multi-pane tabs.
new_tab = "ctrl+alt+super+t"
rename_tab = "ctrl+alt+super+shift+t"
previous_tab = "ctrl+alt+super+["
next_tab = "ctrl+alt+super+]"

# Workspaces and agents — digit layer mirrors browser Cmd/Alt+digit tab
# jumps, just moved onto Hyper. Shift layer selects agents instead of
# workspaces.
switch_workspace = "ctrl+alt+super+1..9"
focus_agent = "ctrl+alt+super+shift+1..9"
new_workspace = "ctrl+alt+super+n"
rename_workspace = "ctrl+alt+super+shift+n"

# Popup scratch tools (herdr 0.7.4+ `type = "popup"`: a session-modal floating
# terminal centred over the whole tab, layout frozen beneath, closing when the
# command exits). Both live on Hyper — lazygit is high-frequency and cheat is
# the "wiki at my fingertips", so both earn a single-chord bind rather than
# prefix. Bare Hyper chords are valid for [[keys.command]] (verified with
# `herdr config check` on 0.7.4). The commands are wrappers on PATH
# (dot_local/bin) because: a popup starts in a default cwd, not the active
# pane's, so lazygit-popup cd's into $HERDR_ACTIVE_PANE_CWD; and cheat-popup
# needs a real shell for its fzf pipeline (default_shell here is fish).
[[keys.command]]
key = "ctrl+alt+super+g"
type = "popup"
command = "lazygit-popup"
description = "lazygit (popup, in active pane's dir)"
width = "90%"
height = "90%"

[[keys.command]]
key = "ctrl+alt+super+c"
type = "popup"
command = "cheat-popup"
description = "cheat wiki (fuzzy popup)"
width = "80%"
height = "80%"
