# Reload config:
# Linux: `ctrl+shift+,`
# MacOS: `cmd+shift+,`

# Theme
background-blur = 50
background-opacity = 0.85

window-padding-x = 8
window-padding-y = 8

# Splits — mirror LazyVim mnemonics (<leader>- and <leader>|)
## Hyper = Caps Lock (tap=Escape, hold=Ctrl+Alt+Super)
keybind = ctrl+alt+super+minus=new_split:down
keybind = ctrl+alt+super+backslash=new_split:right
keybind = ctrl+alt+super+w=close_surface

## Navigation — Ctrl+hjkl is reserved by smart-splits.nvim inside nvim;
## Hyper+hjkl is the terminal-level equivalent with zero conflict.
## Pane navigation itself is unbound here so Hyper+hjkl passes through to
## herdr's own focus_pane_* bindings (dot_config/herdr/config.toml) instead
## of Ghostty consuming it for its own splits.

## Resize — Hyper = 3-mod (Ctrl+Alt+Super), so Shift is a free layer modifier.
## Hyper+Shift+hjkl is distinct from Hyper+hjkl, mirroring LazyVim's resize pattern.
keybind = ctrl+alt+shift+super+h=resize_split:left,10
keybind = ctrl+alt+shift+super+j=resize_split:down,10
keybind = ctrl+alt+shift+super+k=resize_split:up,10
keybind = ctrl+alt+shift+super+l=resize_split:right,10

## Pane management
keybind = ctrl+alt+super+z=toggle_split_zoom
keybind = ctrl+alt+super+equal=equalize_splits

# Quick terminal (global hotkey — works even when Ghostty is not focused)
keybind = global:ctrl+alt+super+grave_accent=toggle_quick_terminal

{{ if eq .chezmoi.os "darwin" -}}
# Unbind macOS-specific defaults that conflict with expected behaviour
keybind = super+d=unbind
keybind = super+shift+w=unbind
keybind = super+alt+w=unbind
{{ end -}}

# Cursor trail + focus indicator (shaders pipeline in order)
custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/focus_indicator.glsl

# Mouse
mouse-hide-while-typing = true

# Tabs
## Rename Tab Title
keybind = ctrl+alt+super+r=prompt_tab_title

