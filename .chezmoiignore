# Docs
*.md
**/*.md
docs/

# Repo-only Python test suite + dev env (never a dotfile)
tests/
.venv/
.pytest_cache/
# Python bytecode caches (the suite importlib-loads the hook/resolver scripts,
# writing __pycache__ next to them — must never deploy into ~/.claude etc.)
**/__pycache__
**/__pycache__/**

# Exceptions — specific .md files that should be managed
!.claude/CLAUDE.md
!.claude/skills/**
!.claude/commands/**

# AeroSpace: macOS-only AND opt-in via features.aerospace (defense-in-depth double gate)
{{ if or (ne .chezmoi.os "darwin") (not .features.aerospace) -}}
.config/aerospace
{{ end -}}

# Obsidian CLI wrapper: only useful where Obsidian is a Flatpak, since it exists
# solely to bridge the app's private XDG_RUNTIME_DIR. Self-detecting rather than
# toggle-gated — a machine without a Flatpak Obsidian never wants this file.
{{ if not (or (stat "/var/lib/flatpak/app/md.obsidian.Obsidian") (stat (joinPath .chezmoi.homeDir ".local/share/flatpak/app/md.obsidian.Obsidian"))) -}}
.local/bin/obsidian
{{ end -}}

# Claude Code runtime state (rewritten on every invocation)
.claude.json
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json

# pi: only settings.json (via modify_), keybindings.json and the modes
# extension are managed — everything else under ~/.pi/agent is a secret, a
# cache, machine-local state, or owned by another installer. See docs/pi.md.
# auth.json = live OAuth tokens; models-store.json = re-fetched provider
# catalogue; trust.json = per-machine absolute project paths; sessions/ =
# transcripts; herdr-agent-state.ts = owned by herdr's own installer, which
# overwrites it on every update (run_once_install-herdr).
.pi/agent/auth.json
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/sessions/
.pi/agent/extensions/herdr-agent-state.ts

# Fish universal variables — managed by run_onchange_after_tide_config.sh, not synced directly
.config/fish/fish_variables
