#!/usr/bin/env python3
"""eos-push-gate — push-time audit for org vaults (ADR-0011; supersedes the
confirm/ack behaviour built under #29).

Work-vault pushes are audited, not gated: the vault carries only org-visible
content by construction (admission control happens at the source boundary),
so there is nothing for a human to veto at push time. The hook's job is
visibility, not permission.

Hook mode (installed as .githooks/pre-push; git passes remote name + URL as
args and the outbound ref lines on stdin):

  1. Print a compact outbound summary: commit count and subjects per ref,
     files changed with adds/dels, flagging any path outside wiki/ and any
     file gaining more than 200 added lines.
  2. Append a `push_audit` event to the eos audit log (best-effort).
  3. Exit 0 — the push always proceeds.

Install mode:

  eos-push-gate --install <vault-path>

writes <vault>/.githooks/pre-push (a shim delegating back to this script)
and sets core.hooksPath, refusing on paths that are not registered vault
roots (checked against the registry via eos-resolve) and refusing to clobber
a foreign pre-push hook (e.g. the Journal's remote pin). Installation is a
deliberate per-vault step — nothing installs this automatically.
"""

import json
import os
import re
import subprocess
import sys

EOS = os.path.expanduser("~/.local/bin/eos-resolve")

LARGE_ADDS = 200
SHIM_MARKER = "eos-push-gate shim"
SHIM = f"""#!/bin/sh
# {SHIM_MARKER} — installed by `eos-push-gate --install` (dotfiles #29).
# Delegates the push-time exposure decision to eos-push-gate; remove this
# file and `git config --unset core.hooksPath` to uninstall.
exec "$HOME/.local/bin/eos-push-gate" "$@"
"""


def git(args, cwd=None):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True,
                       timeout=30)
    return r.stdout if r.returncode == 0 else None


_SHA_RE = re.compile(r"[0-9a-f]{40,64}$")  # sha1 or sha256 object name


def is_zero_sha(sha):
    return set(sha) == {"0"}


def parse_ref_lines(lines):
    """Standard pre-push stdin: `<local_ref> <local_sha> <remote_ref>
    <remote_sha>` per outbound ref. Deletions (zero local sha) carry no
    outbound content and are skipped."""
    updates = []
    for line in lines:
        parts = line.split()
        if len(parts) != 4:
            continue
        local_ref, local_sha, remote_ref, remote_sha = parts
        if not (_SHA_RE.match(local_sha) and _SHA_RE.match(remote_sha)):
            continue
        if is_zero_sha(local_sha):
            continue
        updates.append({"local_ref": local_ref, "local_sha": local_sha,
                        "remote_ref": remote_ref, "remote_sha": remote_sha})
    return updates


def rev_range(update):
    """Git rev args selecting the outbound commits: remote..local for an
    existing ref; for a new ref, everything local not already on any
    remote."""
    if is_zero_sha(update["remote_sha"]):
        return [update["local_sha"], "--not", "--remotes"]
    return [f"{update['remote_sha']}..{update['local_sha']}"]


def outbound_stats(update, repo=None):
    """(subjects, {path: (adds, dels)}) for one ref update. Binary files
    (numstat `-`) count as 0 lines but still appear."""
    rng = rev_range(update)
    subjects = (git(["log", "--format=%s", *rng], cwd=repo) or "").splitlines()
    files = {}
    numstat = git(["log", "--numstat", "--format=", *rng], cwd=repo) or ""
    for line in numstat.splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        adds, dels, path = parts
        a = int(adds) if adds.isdigit() else 0
        d = int(dels) if dels.isdigit() else 0
        pa, pd = files.get(path, (0, 0))
        files[path] = (pa + a, pd + d)
    return subjects, files


def file_flags(path, adds):
    flags = []
    if not path.startswith("wiki/"):
        flags.append("[outside wiki/]")
    if adds > LARGE_ADDS:
        flags.append(f"[+{adds} lines added]")
    return flags


def summary_lines(updates, remote_name, remote_url, repo=None):
    """The compact outbound summary that makes every push reviewable after
    the fact."""
    lines = [f"eos-push-gate: outbound to {remote_name} ({remote_url})"]
    for u in updates:
        subjects, files = outbound_stats(u, repo=repo)
        n = len(subjects)
        lines.append(f"  {u['local_ref']} -> {u['remote_ref']}: "
                     f"{n} commit{'s' if n != 1 else ''}")
        for s in subjects:
            lines.append(f"    - {s}")
        if files:
            lines.append("  files changed:")
            for path in sorted(files):
                adds, dels = files[path]
                flag = "  ".join(file_flags(path, adds))
                lines.append(f"    +{adds}\t-{dels}\t{path}"
                             + (f"  {flag}" if flag else ""))
    return lines


AUDIT_LOG = os.path.expanduser("~/.local/state/engineering-os/audit.jsonl")


def audit_event(updates, remote_name, remote_url, repo=None):
    """Append one push-audit event to the eos audit log. Best-effort: a
    failure to write the log never blocks the push (the summary on stderr is
    the primary record)."""
    import datetime
    event = {
        "ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "event": "push_audit",
        "remote": remote_name,
        "url": remote_url,
        "refs": [{"ref": u["remote_ref"],
                  "commits": len((git(["log", "--format=%H", *rev_range(u)],
                                      cwd=repo) or "").splitlines())}
                 for u in updates],
    }
    try:
        os.makedirs(os.path.dirname(AUDIT_LOG), exist_ok=True)
        with open(AUDIT_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(event) + "\n")
    except OSError:
        pass


def gate(updates, remote_name, remote_url, repo=None, err=None):
    """Summarise and audit; the push always proceeds (ADR-0011)."""
    err = err if err is not None else sys.stderr
    if not updates:
        return 0  # nothing outbound (e.g. deletions only)
    for line in summary_lines(updates, remote_name, remote_url, repo=repo):
        print(line, file=err)
    audit_event(updates, remote_name, remote_url, repo=repo)
    print("eos-push-gate: audited — push proceeds.", file=err)
    return 0


# --------------------------------------------------------------- install ----


def registered_vault_roots():
    """Realpathed roots of every registered vault, via eos-resolve (the
    single home of registry semantics)."""
    try:
        r = subprocess.run([EOS, "vaults", "--json"], capture_output=True,
                           text=True, timeout=15)
        vaults = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        vaults = []
    return {os.path.realpath(v["path"]) for v in vaults if v.get("path")}


def install(vault_path, roots=None, err=None):
    """Wire this gate into one vault: write .githooks/pre-push (shim) and set
    core.hooksPath. Refuses non-vault paths and foreign pre-push hooks."""
    err = err if err is not None else sys.stderr
    real = os.path.realpath(os.path.expanduser(vault_path))
    if roots is None:
        roots = registered_vault_roots()
    if real not in roots:
        print(f"eos-push-gate: refusing — {vault_path} is not a registered "
              "vault root (per eos-resolve vaults). The push gate installs "
              "into vaults only.", file=err)
        return 1
    if not os.path.isdir(os.path.join(real, ".git")):
        print(f"eos-push-gate: refusing — {vault_path} is not a git checkout.",
              file=err)
        return 1
    hook = os.path.join(real, ".githooks", "pre-push")
    if os.path.exists(hook):
        with open(hook, encoding="utf-8") as f:
            existing = f.read()
        if SHIM_MARKER not in existing:
            print(f"eos-push-gate: refusing — {hook} already exists and is "
                  "not an eos-push-gate shim; merge it by hand.", file=err)
            return 1
    os.makedirs(os.path.dirname(hook), exist_ok=True)
    with open(hook, "w", encoding="utf-8") as f:
        f.write(SHIM)
    os.chmod(hook, 0o755)
    if git(["config", "core.hooksPath", ".githooks"], cwd=real) is None:
        print("eos-push-gate: failed to set core.hooksPath.", file=err)
        return 1
    print(f"eos-push-gate: installed into {vault_path} "
          "(.githooks/pre-push + core.hooksPath).", file=err)
    return 0


def main(argv=None, stdin=None, repo=None):
    argv = sys.argv[1:] if argv is None else argv
    stdin = sys.stdin if stdin is None else stdin
    if argv and argv[0] == "--install":
        if len(argv) != 2:
            print("usage: eos-push-gate --install <vault-path>", file=sys.stderr)
            return 2
        return install(argv[1])
    remote_name = argv[0] if len(argv) > 0 else "?"
    remote_url = argv[1] if len(argv) > 1 else "?"
    updates = parse_ref_lines(stdin.read().splitlines())
    return gate(updates, remote_name, remote_url, repo=repo)


if __name__ == "__main__":
    sys.exit(main())
