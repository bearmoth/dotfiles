#!/usr/bin/env python3
"""eos-resolve — engineering-OS registry resolver (wayfinder #10/#23).

The single home of registry semantics. The SessionStart hook, the three
engineering-OS skills, and the statusline all call this instead of parsing
the registry themselves.

Reads ~/.config/engineering-os/registry.json (rendered by chezmoi from
.chezmoidata/contexts.yaml + the machine's data.eos mounts).

Commands:
  context [PATH]   resolve the owning context for PATH (default: cwd)
  banner  [PATH]   SessionStart block: context + mounts + attribution + pulse
  pulse            freshness pulse lines (worklog/journal recency; threshold-
                   gated lines for _inbox, de-spec queue, ingestion staleness)
  health           one-shot workflow health report ("are we healthy"): pulse,
                   per-vault git state, queue/eos-issues debt, merged-worktree
                   cleanup candidates. Read-only; OK/ATTN per line + verdict.
  mounts           this machine's mounts
  vaults           every registered vault with exposure and local path

All commands accept --json. Exit codes: 0 ok, 1 unresolved (context), 3 no
registry.
"""

import argparse
import fnmatch
import json
import os
import re
import subprocess
import sys
import time

REGISTRY = os.path.expanduser("~/.config/engineering-os/registry.json")
STATE = os.path.expanduser(os.environ.get("EOS_STATE", "~/.local/state/engineering-os"))

# Pulse thresholds (days) — pilot-tunable via env (wayfinder #15/#16).
INBOX_MAX_DAYS = int(os.environ.get("EOS_INBOX_MAX_DAYS", "14"))
DESPEC_MAX_DAYS = int(os.environ.get("EOS_DESPEC_MAX_DAYS", "14"))
INGEST_MAX_DAYS = int(os.environ.get("EOS_INGEST_MAX_DAYS", "10"))
ISSUES_MAX_DAYS = int(os.environ.get("EOS_ISSUES_MAX_DAYS", "14"))
QUEUE_MAX_DAYS = int(os.environ.get("EOS_QUEUE_MAX_DAYS", "7"))

SKIP_DIRS = {".git", ".obsidian", ".trash", ".claude", "node_modules"}


def load_registry():
    try:
        with open(REGISTRY) as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        print(f"eos-resolve: cannot read {REGISTRY}: {e}", file=sys.stderr)
        print("Run `chezmoi apply` to render the registry.", file=sys.stderr)
        sys.exit(3)


def git(args, cwd=None):
    try:
        out = subprocess.run(
            ["git", *args], cwd=cwd, capture_output=True, text=True, timeout=10
        )
        return out.stdout.strip() if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def normalize_remote(url):
    """git@github.com:owner/repo.git / https://github.com/owner/repo.git
    -> github.com/owner/repo"""
    if not url:
        return None
    m = re.match(r"^(?:ssh://)?(?:[\w.-]+@)?([\w.-]+)[:/](.+?)(?:\.git)?/?$", url)
    if m:
        host, path = m.group(1), m.group(2)
        return f"{host}/{path}"
    m = re.match(r"^https?://([\w.-]+)/(.+?)(?:\.git)?/?$", url)
    if m:
        return f"{m.group(1)}/{m.group(2)}"
    return None


def all_vaults(reg):
    """Yield (context, role_or_None, vault_dict) for every registered vault."""
    for ctx, cdef in reg.get("contexts", {}).items():
        for role, v in (cdef.get("vaults") or {}).items():
            yield ctx, role, v
        for v in cdef.get("roleless") or []:
            yield ctx, None, v


def path_within(path, root):
    path = os.path.realpath(path)
    root = os.path.realpath(root)
    return path == root or path.startswith(root + os.sep)


def parse_ticket(branch):
    """Derive the ticket ref from a branch name (wayfinder #13: derived by
    parsing, never stored). e.g. ABC-123-fix-thing -> ABC-123."""
    if not branch:
        return None
    m = re.search(r"\b([A-Za-z][A-Za-z0-9_]*-\d+)\b", branch)
    return m.group(1) if m else None


def resolve_context(reg, path):
    """Resolve the owning context for a path.

    Order: vault membership -> repo ownership pattern (remote) -> machine
    path rule (longest matching root). No fallback context (wayfinder #9):
    unresolved is a surfaced fact, never a default.
    """
    path = os.path.realpath(path)
    result = {
        "path": path,
        "context": None,
        "method": None,
        "vault": None,
        "repo": None,
        "branch": None,
        "ticket": None,
    }

    # 1. Inside a registered vault?
    for ctx, role, v in all_vaults(reg):
        vpath = v.get("path")
        if vpath and path_within(path, vpath):
            result.update(
                context=ctx,
                method="vault",
                vault={"name": v["name"], "role": role, "exposure": v["exposure"]},
            )
            return result

    # 2. Inside a git repo whose remote matches an ownership pattern?
    toplevel = git(["rev-parse", "--show-toplevel"], cwd=path if os.path.isdir(path) else os.path.dirname(path))
    if toplevel:
        remote = normalize_remote(git(["remote", "get-url", "origin"], cwd=toplevel))
        branch = git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=toplevel)
        result["branch"] = branch
        result["ticket"] = parse_ticket(branch)
        if remote:
            owner_repo = "/".join(remote.split("/")[1:3])
            result["repo"] = {"remote": remote, "slug": owner_repo}
            for ctx, cdef in reg.get("contexts", {}).items():
                for pattern in cdef.get("ownership") or []:
                    # Match both org-level (host/owner/*) and exact repo patterns.
                    if fnmatch.fnmatch(remote, pattern) or fnmatch.fnmatch(
                        remote + "/", pattern
                    ):
                        result.update(context=ctx, method="ownership")
                        return result

    # 3. Machine path rules (longest matching root wins).
    best = None
    for ctx, cdef in reg.get("contexts", {}).items():
        for root in cdef.get("roots") or []:
            if path_within(path, root):
                if best is None or len(os.path.realpath(root)) > len(best[1]):
                    best = (ctx, os.path.realpath(root))
    if best:
        result.update(context=best[0], method="path-rule")
        return result

    return result  # unresolved


# ---------------------------------------------------------------- pulse ----


def newest_mtime(root, match=None, max_depth=None):
    """Newest file mtime under root (skipping vault plumbing dirs)."""
    newest = None
    root = os.path.realpath(root)
    base_depth = root.count(os.sep)
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        if max_depth is not None and dirpath.count(os.sep) - base_depth >= max_depth:
            dirnames[:] = []
        for fn in filenames:
            if match and not fnmatch.fnmatch(fn, match):
                continue
            try:
                mt = os.path.getmtime(os.path.join(dirpath, fn))
            except OSError:
                continue
            if newest is None or mt > newest:
                newest = mt
    return newest


def age_days(mtime):
    return int((time.time() - mtime) // 86400) if mtime else None


def read_jsonl(path):
    """Records from a jsonl file; absent file -> empty (readers tolerate
    absence, ADR-0007)."""
    recs = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    recs.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return recs


def day_age(day):
    """Age in days of a YYYY-MM-DD string; None if malformed."""
    try:
        return int((time.time() - time.mktime(time.strptime(day, "%Y-%m-%d"))) // 86400)
    except (ValueError, OverflowError):
        return None


def note_contexts(path, default_ctx):
    """Contexts a ledger note covers: its frontmatter `about:` list, else the
    journal's own context (dated notes inherit the era default)."""
    ctxs = set()
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f):
                if i > 12:
                    break
                m = re.match(r"^about:\s*\[(.*)\]\s*$", line)
                if m:
                    ctxs = {c.strip().strip("'\"") for c in m.group(1).split(",") if c.strip()}
                    break
    except OSError:
        pass
    return ctxs or {default_ctx}


def worklog_ages(journal_path, journal_ctx):
    """Per-context age of the newest work record (ADR-0009): the freshest of
    the local eos queue (pending + drained work-record entries, by attribution
    context) and the synced Journal ledger notes (log/YYYY-MM-DD <machine>.md,
    contexts from frontmatter). Also returns (pending_count, oldest_pending_age,
    unresolved_machine) for the queue debt line."""
    ages = {}

    def take(ctx, age):
        if ctx and age is not None and (ctx not in ages or age < ages[ctx]):
            ages[ctx] = age

    pending = read_jsonl(os.path.join(STATE, "queue.jsonl"))
    unresolved_machine = any(
        str(r.get("machine", "")).startswith("UNRESOLVED-") for r in pending
    )
    oldest_pending = None
    for rec in pending:
        a = day_age((rec.get("ts") or "")[:10])
        if a is not None and (oldest_pending is None or a > oldest_pending):
            oldest_pending = a
    for rec in pending + read_jsonl(os.path.join(STATE, "queue-drained.jsonl")):
        if rec.get("kind") != "work-record":
            continue
        take((rec.get("attribution") or {}).get("context"), day_age((rec.get("ts") or "")[:10]))

    logdir = os.path.join(journal_path, "log") if journal_path else None
    if logdir and os.path.isdir(logdir):
        for fn in os.listdir(logdir):
            m = re.match(r"^(\d{4}-\d{2}-\d{2})\b.*\.md$", fn)
            if not m:
                continue
            age = day_age(m.group(1))
            for ctx in note_contexts(os.path.join(logdir, fn), journal_ctx):
                take(ctx, age)

    return ages, len(pending), oldest_pending, unresolved_machine


def ingest_age(vault_path):
    """Age of the last ingest (wayfinder #24): the newest `## [YYYY-MM-DD]
    ingest | ...` entry in a log.md at the vault root or one level down (the
    PKB's wiki/log.md) — the ingest workflow's own record, not a file-mtime
    side-effect. Falls back to newest mtime under raw/ when no entry exists."""
    newest = None
    candidates = [os.path.join(vault_path, "log.md")] + [
        os.path.join(vault_path, d, "log.md")
        for d in (os.listdir(vault_path) if os.path.isdir(vault_path) else [])
        if os.path.isdir(os.path.join(vault_path, d)) and d not in SKIP_DIRS and not d.startswith(".")
    ]
    for logfile in candidates:
        if not os.path.isfile(logfile):
            continue
        try:
            with open(logfile, encoding="utf-8", errors="replace") as f:
                for line in f:
                    m = re.match(r"^##\s*\[(\d{4}-\d{2}-\d{2})\]\s*ingest\s*\|", line)
                    if m and (newest is None or m.group(1) > newest):
                        newest = m.group(1)
        except OSError:
            continue
    if newest:
        try:
            return age_days(time.mktime(time.strptime(newest, "%Y-%m-%d")))
        except ValueError:
            pass
    raw = os.path.join(vault_path, "raw")
    if os.path.isdir(raw):
        return age_days(newest_mtime(raw))
    return None


def despec_queue_state(wiki_path):
    """(count, oldest_age_days) of undrained de-spec queue entries."""
    qfile = os.path.join(wiki_path, "WIP", "De-spec Queue.md")
    if not os.path.isfile(qfile):
        return 0, None
    dates = []
    try:
        with open(qfile, encoding="utf-8", errors="replace") as f:
            for line in f:
                if re.match(r"^#+\s*Drained\b", line, re.IGNORECASE):
                    break
                dates += re.findall(r"\b(\d{4}-\d{2}-\d{2})\b", line)
    except OSError:
        return 0, None
    if not dates:
        return 0, None
    oldest = min(dates)
    try:
        oldest_age = int((time.time() - time.mktime(time.strptime(oldest, "%Y-%m-%d"))) // 86400)
    except ValueError:
        oldest_age = None
    return len(dates), oldest_age


def inbox_state(journal_path):
    """(count, oldest_age_days) of untriaged _inbox/ items."""
    inbox = os.path.join(journal_path, "_inbox")
    if not os.path.isdir(inbox):
        return 0, None
    oldest = None
    count = 0
    for dirpath, dirnames, filenames in os.walk(inbox):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for fn in filenames:
            if fn.startswith("."):
                continue
            count += 1
            try:
                mt = os.path.getmtime(os.path.join(dirpath, fn))
            except OSError:
                continue
            if oldest is None or mt < oldest:
                oldest = mt
    return count, age_days(oldest)


def issues_state():
    """(count, oldest_age_days, blocking_count) of open eos-issues backlog
    sightings (ADR-0007). Machine-global — the inbox is not a vault. Absent
    file -> zero (readers tolerate absence)."""
    path = os.path.join(STATE, "eos-issues.jsonl")
    count = blocking = 0
    oldest = None  # oldest ISO date string, lexically comparable
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                count += 1
                if rec.get("severity") == "blocking":
                    blocking += 1
                day = (rec.get("ts") or "")[:10]
                if re.fullmatch(r"\d{4}-\d{2}-\d{2}", day) and (oldest is None or day < oldest):
                    oldest = day
    except OSError:
        return 0, None, 0
    oldest_age = None
    if oldest:
        try:
            oldest_age = int((time.time() - time.mktime(time.strptime(oldest, "%Y-%m-%d"))) // 86400)
        except ValueError:
            oldest_age = None
    return count, oldest_age, blocking


def compute_pulse(reg):
    """The pulse (wayfinder #14/#16): per-destination freshness. Always-on
    recency lines; threshold-gated debt lines (silent unless rotting)."""
    lines = []
    data = {}
    contexts = reg.get("contexts", {})

    journal = journal_ctx = None
    for ctx in sorted(contexts):
        jv = (contexts[ctx].get("vaults") or {}).get("journal") or {}
        if jv.get("path"):
            journal, journal_ctx = jv["path"], ctx
            break

    # Worklog freshness (ADR-0009): local eos queue + synced Journal ledger,
    # never a wiki — worklogs are journal material.
    wl_ages, q_count, q_oldest, q_unresolved = worklog_ages(journal, journal_ctx)
    personal_wiki = None
    for ctx in sorted(contexts):
        cdef = contexts[ctx]
        vaults = cdef.get("vaults") or {}
        wa = wl_ages.get(ctx)
        data.setdefault("worklog", {})[ctx] = wa
        lines.append(
            f"worklog {ctx}: "
            + ("no entries yet" if wa is None else f"last entry {wa}d ago")
        )
        wiki = vaults.get("wiki") or {}
        if wiki.get("path"):
            if ctx == "personal":
                personal_wiki = wiki["path"]
            # Ingestion heartbeat: last `ingest` entry in the vault's own
            # log.md (raw/ mtime as fallback) — wayfinder #16/#24.
            ia = ingest_age(wiki["path"])
            if ia is not None:
                data.setdefault("ingest", {})[ctx] = ia
                if ia > INGEST_MAX_DAYS:
                    lines.append(
                        f"ingest {ctx}: last ingest {ia}d ago (>{INGEST_MAX_DAYS}d) — run /weekly-ingest in {wiki['name']}"
                    )
    if journal:
        ja = age_days(newest_mtime(journal, match="*.md"))
        data["journal"] = ja
        lines.append(
            "journal: " + ("empty" if ja is None else f"last note {ja}d ago")
        )

    # Queue debt (ADR-0009): what keeps "dump centrally, triage later" honest.
    # Silent unless rotting — except UNRESOLVED-* stamps, which surface
    # immediately (they threaten the ledger's single-writer guarantee). Two
    # distinct states: no machine.id declared -> the chezmoi init remedy;
    # id declared but entries pre-date it -> drain (init cannot rewrite
    # already-stamped entries).
    data["queue"] = {"count": q_count, "oldest_days": q_oldest, "unresolved_machine": q_unresolved}
    if q_unresolved:
        machine_id = (reg.get("machine") or {}).get("id")
        if machine_id:
            stamps = sorted({
                str(r.get("machine"))
                for r in read_jsonl(os.path.join(STATE, "queue.jsonl"))
                if str(r.get("machine", "")).startswith("UNRESOLVED-")
            })
            lines.append(
                f"queue: {q_count} pending stamped {', '.join(stamps)} (queued "
                "before machine.id was declared) — drain to clear (ADR-0009)"
            )
        else:
            lines.append(
                f"queue: {q_count} pending with UNDECLARED machine.id — set it via `chezmoi init` (ADR-0009)"
            )
    elif q_count and q_oldest is not None and q_oldest > QUEUE_MAX_DAYS:
        lines.append(
            f"queue: {q_count} pending, oldest {q_oldest}d (>{QUEUE_MAX_DAYS}d) — drain via knowledge-routing triage"
        )

    if journal:
        count, oldest = inbox_state(journal)
        data["inbox"] = {"count": count, "oldest_days": oldest}
        if oldest is not None and oldest > INBOX_MAX_DAYS:
            lines.append(
                f"_inbox: {count} untriaged, oldest {oldest}d (>{INBOX_MAX_DAYS}d) — drain via knowledge-routing triage"
            )

    if personal_wiki:
        count, oldest = despec_queue_state(personal_wiki)
        data["despec"] = {"count": count, "oldest_days": oldest}
        if oldest is not None and oldest > DESPEC_MAX_DAYS:
            lines.append(
                f"de-spec queue: {count} queued, oldest {oldest}d (>{DESPEC_MAX_DAYS}d) — drain via /despec"
            )

    # Engineering-OS defect backlog (ADR-0007). Machine-global, not per-context.
    # Blocking defects surface immediately; the rest once they age past
    # threshold — the same silent-unless-rotting rule as the debt lines above.
    icount, ioldest, iblocking = issues_state()
    data["eos_issues"] = {"count": icount, "oldest_days": ioldest, "blocking": iblocking}
    if icount and (iblocking or (ioldest is not None and ioldest > ISSUES_MAX_DAYS)):
        age = f", oldest {ioldest}d" if ioldest is not None else ""
        sev = f", {iblocking} blocking" if iblocking else ""
        lines.append(
            f"eos-issues: {icount} open{sev}{age} — drain via registry-maintenance routines-audit"
        )

    return lines, data


# --------------------------------------------------------------- health ----
# One-shot workflow health report ("are we healthy"): the pulse, per-vault
# git state, queue/eos-issues debt, and merged-worktree cleanup candidates.
# Strictly read-only aggregation — never mutates anything.


def chezmoi_source_path():
    """The chezmoi source clone — the repo carrying these very routines.
    Resolved via `chezmoi source-path` when available, else the default
    location."""
    try:
        r = subprocess.run(["chezmoi", "source-path"], capture_output=True,
                           text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return os.path.expanduser("~/.local/share/chezmoi")


def vault_git_state(path):
    """(dirty, untracked, unpushed_or_None) for a vault checkout; None when
    `path` is not a git repo. unpushed is None when there is no upstream."""
    porcelain = git(["status", "--porcelain"], cwd=path)
    if porcelain is None:
        return None
    entries = [l for l in porcelain.splitlines() if l.strip()]
    untracked = sum(1 for l in entries if l.startswith("??"))
    dirty = len(entries) - untracked
    ahead = git(["rev-list", "--count", "@{upstream}..HEAD"], cwd=path)
    unpushed = int(ahead) if ahead is not None and ahead.isdigit() else None
    return dirty, untracked, unpushed


def find_worktrees(root, max_depth=4):
    """Git checkouts under the machine worktree root (a dir owning a .git),
    without descending into them."""
    found = []
    if not root or not os.path.isdir(root):
        return found
    root = os.path.realpath(root)
    base_depth = root.count(os.sep)
    for dirpath, dirnames, filenames in os.walk(root):
        if ".git" in dirnames or ".git" in filenames:
            dirnames[:] = []
            found.append(dirpath)
            continue
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if dirpath.count(os.sep) - base_depth >= max_depth:
            dirnames[:] = []
    return sorted(found)


def worktree_removable(path):
    """(branch, default_branch) when this checkout's branch is merged into
    origin/<default> AND the tree is clean — a cleanup candidate; else None.
    Read-only: local refs only, no fetch."""
    branch = git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=path)
    if not branch or branch == "HEAD":
        return None
    head_ref = git(["symbolic-ref", "refs/remotes/origin/HEAD"], cwd=path)
    default = head_ref.rsplit("/", 1)[-1] if head_ref else None
    if default is None:
        for cand in ("main", "master"):
            if git(["rev-parse", "--verify", f"origin/{cand}"], cwd=path) is not None:
                default = cand
                break
    if not default or branch == default:
        return None
    merged = git(["merge-base", "--is-ancestor", "HEAD", f"origin/{default}"], cwd=path)
    if merged is None:  # non-zero exit: not merged (or no such ref)
        return None
    porcelain = git(["status", "--porcelain"], cwd=path)
    if porcelain is None or porcelain.strip():
        return None
    return branch, default


def compute_health(reg):
    """One line per item, each led by an OK/ATTN marker, ending with a
    one-line overall verdict."""
    lines = []

    def add(ok, text):
        lines.append(f"{'OK  ' if ok else 'ATTN'} {text}")

    # Pulse: recency lines are informational (OK); threshold-gated lines only
    # appear once something is rotting, so they surface as ATTN.
    pulse_lines, pulse_data = compute_pulse(reg)
    for l in pulse_lines:
        add(l.startswith(("worklog ", "journal:")), f"pulse: {l}")

    # Per-vault git state from this machine's mounts.
    for ctx, role, v in all_vaults(reg):
        path = v.get("path")
        if not path or not os.path.isdir(path):
            continue
        state = vault_git_state(path)
        if state is None:
            add(True, f"vault {v['name']}: not a git repo")
            continue
        dirty, untracked, unpushed = state
        sync = f"{unpushed} unpushed" if unpushed is not None else "no upstream"
        ok = dirty == 0 and untracked == 0 and unpushed == 0
        add(ok, f"vault {v['name']}: {dirty} dirty, {untracked} untracked, {sync}")

    # The dotfiles source clone itself — the repo carrying these routines.
    # Dirty/unpushed engineering-OS changes are workflow debt like any vault.
    dotfiles = chezmoi_source_path()
    if dotfiles and os.path.isdir(dotfiles):
        state = vault_git_state(dotfiles)
        if state is None:
            add(True, "repo dotfiles: not a git repo")
        else:
            dirty, untracked, unpushed = state
            sync = f"{unpushed} unpushed" if unpushed is not None else "no upstream"
            ok = dirty == 0 and untracked == 0 and unpushed == 0
            add(ok, f"repo dotfiles: {dirty} dirty, {untracked} untracked, {sync}")

    # Queue + eos-issues debt (always shown here, unlike the pulse's
    # threshold-gated lines).
    q = pulse_data.get("queue", {})
    q_ok = not q.get("unresolved_machine") and not (
        q.get("count") and (q.get("oldest_days") or 0) > QUEUE_MAX_DAYS
    )
    oldest = f", oldest {q['oldest_days']}d" if q.get("count") and q.get("oldest_days") is not None else ""
    add(q_ok, f"queue: {q.get('count', 0)} pending{oldest}")

    i = pulse_data.get("eos_issues", {})
    add(not i.get("blocking"), f"eos-issues: {i.get('count', 0)} open, {i.get('blocking', 0)} blocking")

    # Merged-worktree cleanup candidates.
    candidates = 0
    for wt in find_worktrees((reg.get("machine") or {}).get("worktree_root")):
        r = worktree_removable(wt)
        if r:
            candidates += 1
            add(False, f"worktree {home_tilde(wt)}: {r[0]} merged into origin/{r[1]}, clean — removable")
    if not candidates:
        add(True, "worktrees: no merged cleanup candidates")

    attn = sum(1 for l in lines if l.startswith("ATTN"))
    lines.append(
        "verdict: healthy — all clear" if attn == 0
        else f"verdict: {attn} item{'s' if attn != 1 else ''} need attention"
    )
    return lines


# --------------------------------------------------------------- output ----


def home_tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path and path.startswith(home) else path


def mounts_lines(reg):
    def tag(v):
        # exposure (who may see it) + the sensitivity marker when private
        # (ADR-0008: personal != private).
        t = v.get("exposure", "?")
        if v.get("private"):
            t += ", private"
        return t

    lines = []
    for ctx in sorted(reg.get("contexts", {})):
        cdef = reg["contexts"][ctx]
        for role in sorted(cdef.get("vaults") or {}):
            v = cdef["vaults"][role]
            loc = home_tilde(v.get("path")) if v.get("path") else "not on this machine"
            lines.append(f"{ctx} {role}: {v['name']} ({tag(v)}) — {loc}")
        for v in cdef.get("roleless") or []:
            loc = home_tilde(v.get("path")) if v.get("path") else "not on this machine"
            lines.append(
                f"{ctx} roleless: {v['name']} ({tag(v)}, not a routing destination) — {loc}"
            )
    machine = reg.get("machine", {})
    if machine.get("clone_root") or machine.get("worktree_root"):
        lines.append(
            f"clone root: {home_tilde(machine.get('clone_root', '?'))} | worktree root: {home_tilde(machine.get('worktree_root', '?'))}"
        )
    return lines


def context_lines(res):
    if res["context"]:
        line = f"Context: {res['context']} (via {res['method']}"
        if res.get("repo"):
            line += f": {res['repo']['slug']}"
        elif res.get("vault"):
            line += f": {res['vault']['name']}"
        line += ")"
        lines = [line]
        if res.get("branch"):
            attr = f"Attribution: ({res['context']}, {res['repo']['slug'] if res.get('repo') else '?'}, {res.get('ticket') or 'no-ticket'}, {res['branch']})"
            lines.append(attr)
        return lines
    return [
        "Context: UNRESOLVED — this directory maps to no context; knowledge",
        "routing is disabled for this session (no default, by design). Fix via",
        "the registry-maintenance skill: add an ownership pattern to",
        ".chezmoidata/contexts.yaml or a machine root to ~/.config/chezmoi/chezmoi.yaml.",
    ]


def main():
    ap = argparse.ArgumentParser(prog="eos-resolve", description=__doc__)
    ap.add_argument("command", choices=["context", "banner", "pulse", "health", "mounts", "vaults"])
    ap.add_argument("path", nargs="?", default=os.getcwd())
    ap.add_argument("--json", action="store_true", dest="as_json")
    args = ap.parse_intermixed_args()

    reg = load_registry()

    if args.command == "context":
        res = resolve_context(reg, args.path)
        if args.as_json:
            print(json.dumps(res, indent=2))
        else:
            print("\n".join(context_lines(res)))
        sys.exit(0 if res["context"] else 1)

    if args.command == "vaults":
        vaults = [
            {"context": ctx, "role": role, **v} for ctx, role, v in all_vaults(reg)
        ]
        if args.as_json:
            print(json.dumps(vaults, indent=2))
        else:
            print("\n".join(mounts_lines(reg)))
        return

    if args.command == "mounts":
        if args.as_json:
            print(json.dumps({"machine": reg.get("machine", {}), "contexts": reg.get("contexts", {})}, indent=2))
        else:
            print("\n".join(mounts_lines(reg)))
        return

    if args.command == "pulse":
        lines, data = compute_pulse(reg)
        if args.as_json:
            print(json.dumps(data, indent=2))
        else:
            print("\n".join(lines))
        return

    if args.command == "health":
        lines = compute_health(reg)
        if args.as_json:
            print(json.dumps({"lines": lines}, indent=2))
        else:
            print("\n".join(lines))
        return

    if args.command == "banner":
        res = resolve_context(reg, args.path)
        pulse_lines, pulse_data = compute_pulse(reg)
        if args.as_json:
            print(json.dumps({"context": res, "mounts": reg, "pulse": pulse_data}, indent=2))
            return
        out = ["## Engineering OS"]
        out += context_lines(res)
        out.append("Mounts:")
        out += ["  " + l for l in mounts_lines(reg)]
        out.append("Pulse:")
        out += ["  " + l for l in pulse_lines]
        out.append(
            "Registry: ~/.config/engineering-os/registry.yaml | Glossary: CONTEXT.md in bearmoth/dotfiles"
        )
        print("\n".join(out))


if __name__ == "__main__":
    main()
