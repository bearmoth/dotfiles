{{- /*
Shell functions for the npm package tier (ADR-0011). Included via
`includeTemplate "npm-tools" .` by run_before_all-02 (install missing) and
run_onchange_upgrade-packages (weekly upgrade) — the two places every other
tier is handled, so npm packages ride the same contract as brews and dnf
packages rather than a private mechanism per tool.

npm needs two things no other tier needs, both consequences of this machine
having a node version manager for project work:

  1. A pinned interpreter. npm bins ship `#!/usr/bin/env node`, so they
     resolve node from PATH at invocation — a project-switched node breaks an
     otherwise fine global install. We generate a wrapper per bin that execs
     the brew/dnf-managed node explicitly. (Homebrew solves the same problem by
     rewriting the shebang to an absolute path under its own node prefix.)
  2. A smoke test, because npm will happily install something that cannot
     run. Measured against pi (`engines: >=22.19.0`) on node 20.20.2 with
     npm 10.8.2: npm installs the *latest* release, emits **no** EBADENGINE
     warning, and does not fall back to the older release that does satisfy
     the range — the tool then dies at first invocation inside a dependency
     (`webidl.util.markAsUncloneable is not a function`). `--engine-strict`
     does not change this. So npm's own signals cannot be trusted here, and
     an explicit check is the only reliable guard.

Rather than compare semver ranges (which needs a real range parser we do not
have in shell), the check simply runs the installed bin under the pinned node.
That directly tests the thing we care about and also catches native-module ABI
mismatches, not just declared-engine mismatches. Known limitation: it assumes
the bin supports `--version`. A future package that does not will show up as a
loud warning on the machine, at which point it needs a per-package opt-out —
deliberately not built in advance.

Deliberately not driven by `command -v node`: the interpreter these tools get
pinned to is the brew/dnf-managed one, never whichever node a version manager
happens to have put on PATH when `chezmoi apply` ran.
*/ -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ if eq .chezmoi.arch "arm64" -}}
NPM_TIER_NODE=/opt/homebrew/bin/node
NPM_TIER_NPM=/opt/homebrew/bin/npm
{{ else -}}
NPM_TIER_NODE=/usr/local/bin/node
NPM_TIER_NPM=/usr/local/bin/npm
{{ end -}}
{{ else -}}
NPM_TIER_NODE=/usr/bin/node
NPM_TIER_NPM=/usr/bin/npm
{{ end -}}
NPM_TIER_PREFIX="$HOME/.local/share/npm"
NPM_TIER_BIN="$HOME/.local/bin"

npm_tier_available() {
	[ -x "$NPM_TIER_NODE" ] && [ -x "$NPM_TIER_NPM" ]
}

npm_tier_dir() {
	printf '%s/lib/node_modules/%s' "$NPM_TIER_PREFIX" "$1"
}

npm_tier_installed() {
	[ -d "$(npm_tier_dir "$1")" ]
}

# Install or upgrade one package, verify it runs, then (re)generate wrappers.
# Returns non-zero on failure so callers decide whether that is fatal.
npm_tier_sync() {
	npm_tier_pkg="$1"
	# --ignore-scripts mirrors every install command upstream documents.
	# --prefix keeps this out of /usr (no sudo) and out of any version
	# manager's global prefix, which evaporates when that node is pruned.
	# Bare package name, not `@latest`: it upgrades an existing install just
	# the same, and leaves any future engine-aware resolution npm may do
	# available rather than overriding it.
	if ! "$NPM_TIER_NPM" install -g --ignore-scripts --prefix "$NPM_TIER_PREFIX" \
		--no-fund --no-audit --loglevel=error "$npm_tier_pkg"; then
		echo "Warning: npm tier: $npm_tier_pkg install/upgrade failed" >&2
		return 1
	fi
	npm_tier_wrap "$npm_tier_pkg"
}

# Emit "name<TAB>relative-path" for each entry in the package's own `bin` map,
# so this works for any package including multi-bin ones — never a hardcoded
# binary name.
npm_tier_bins() {
	"$NPM_TIER_NODE" -e '
		const dir = process.argv[1];
		const pkg = require(dir + "/package.json");
		const bin = typeof pkg.bin === "string"
			? { [pkg.name.split("/").pop()]: pkg.bin }
			: (pkg.bin || {});
		for (const [name, rel] of Object.entries(bin)) console.log(name + "\t" + rel);
	' "$1" 2>/dev/null
}

npm_tier_wrap() {
	npm_tier_dir_path=$(npm_tier_dir "$1")
	mkdir -p "$NPM_TIER_BIN"
	npm_tier_bins "$npm_tier_dir_path" | while IFS="$(printf '\t')" read -r npm_tier_name npm_tier_rel; do
		[ -n "$npm_tier_name" ] || continue

		# Refuse to put something on PATH that cannot run under the node we
		# are about to pin it to — an absent tool with a reason beats a tool
		# that crashes in a dependency when you next reach for it.
		if ! "$NPM_TIER_NODE" "$npm_tier_dir_path/$npm_tier_rel" --version >/dev/null 2>&1; then
			echo "Warning: npm tier: $1 installed but '$npm_tier_name' does not run under" >&2
			echo "  $NPM_TIER_NODE ($("$NPM_TIER_NODE" --version)). Package requires node" >&2
			echo "  $("$NPM_TIER_NODE" -p "(require('$npm_tier_dir_path/package.json').engines||{}).node || 'unknown'")." >&2
			echo "  Not linking $NPM_TIER_BIN/$npm_tier_name — upgrade node, then re-run chezmoi apply." >&2
			rm -f "$NPM_TIER_BIN/$npm_tier_name"
			continue
		fi

		cat >"$NPM_TIER_BIN/$npm_tier_name" <<EOF
#!/bin/sh
# Generated by chezmoi (.chezmoitemplates/npm-tools) — do not edit.
# Pins $npm_tier_name to $NPM_TIER_NODE so a project-switched node cannot break it.
exec $NPM_TIER_NODE "$npm_tier_dir_path/$npm_tier_rel" "\$@"
EOF
		chmod +x "$NPM_TIER_BIN/$npm_tier_name"
	done
}
