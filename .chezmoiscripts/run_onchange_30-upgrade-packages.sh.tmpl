#!/bin/bash
# Weekly upgrade of chezmoi-managed packages.
#
# Re-run weekly: {{ now.Year }}-W{{ div now.YearDay 7 }}
#
# KNOWN GAP (see docs/package-management.md): coupling `brew`/`dnf upgrade`
# into `chezmoi apply` makes apply slow and non-deterministic — a routine
# apply can suddenly spend minutes upgrading, or pull a breaking change at a
# time we didn't choose. Accepted deliberately for now, gated to run at most
# once a week via the date-stamped comment above. Revisit later (a launchd /
# systemd timer, or an explicit "upgrade" command, would decouple it).
#
# Scoped ON PURPOSE to the formulae/dnf packages declared in
# .chezmoidata/packages.yaml — never a bare `brew upgrade` (which would also
# upgrade casks like Karabiner-Elements and Ghostty) nor a full `dnf upgrade`
# (whole-OS). Casks and the base OS stay deliberate, manual upgrades.
set -uo pipefail
# No -e: one formula/package failing (e.g. an untrusted tap, a missing
# bottle) must not abort the whole batch or fail this script — that would
# make chezmoi apply itself fail, repeatedly, on every run until someone
# intervenes manually. Failures are collected and reported instead.

failed=()

{{ if eq .chezmoi.os "darwin" -}}
echo "Upgrading managed Homebrew formulae..."
echo "Skipping herdr in chezmoi; update it manually outside herdr."
{{ range .packages.darwin.brews -}}
{{ if ne . "herdr" -}}
brew upgrade {{ . }} || failed+=("{{ . }}")
{{ end -}}
{{ end -}}
{{ else if eq .chezmoi.os "linux" -}}
echo "Upgrading managed dnf packages..."
{{ range .packages.fedora.dnf -}}
sudo dnf upgrade -y {{ . }} || failed+=("{{ . }}")
{{ end -}}
{{ end -}}

{{ if .packages.npm -}}
{{ includeTemplate "npm-tools" . }}
# pi updates itself (ADR-0012): `pi update` replays `npm install -g` against
# the prefix inferred from its own install path — exactly the tier's layout —
# so upstream's updater and the tier are one mechanism, and --all sweeps pi's
# extensions too. The pinned npm's dir leads PATH so the replayed install
# uses the npm that installed pi, never a version manager's; stdin is closed
# so an unexpected prompt fails fast instead of hanging apply.
# Deliberately no npm_tier_sync loop here: for a self-updating tool it would
# be the same npm command run twice. If a non-self-updating npm CLI ever
# joins the tier, reintroduce the sync loop for it then (see
# docs/package-management.md).
if npm_tier_available && [ -x "$NPM_TIER_BIN/pi" ]; then
	echo "Updating pi and extensions (pi update --all)..."
	PATH="$(dirname "$NPM_TIER_NPM"):$PATH" "$NPM_TIER_BIN/pi" update --all </dev/null || failed+=("pi-update")
	# Re-run the smoke test + wrapper regen after every self-update: a new
	# release may raise pi's node floor past the pinned node, and the
	# refuse-to-link contract (ADR-0011) applies at update time, not just
	# install time.
	# (npm_tier_wrap warns loudly on refusal but never returns non-zero —
	# refuse-to-link is a warning, not a sweep failure.)
{{ range .packages.npm -}}
	npm_tier_wrap {{ . | quote }}
{{ end -}}
fi
{{ end -}}

if [ "${#failed[@]}" -gt 0 ]; then
  echo "Warning: failed to upgrade: ${failed[*]} (see output above for why — often an untrusted tap; run 'brew trust' or migrate to homebrew-core)" >&2
fi
exit 0
