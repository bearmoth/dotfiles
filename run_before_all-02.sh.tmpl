{{ if eq .osid "darwin" -}}
#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.arch "arm64" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/usr/local/bin/brew shellenv)"
{{ end -}}

{{ range .packages.darwin.taps -}}
tap={{ . | quote }}
case "$tap" in
	*/*/*) tap="${tap%/*}" ;;
esac
brew tap "$tap"
{{ end -}}

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}


{{ if eq .osid "linux-fedora" -}}
#!/bin/bash
set -euo pipefail

{{ $pkgs := .packages.fedora.dnf }}
sudo dnf install -y {{ $pkgs | join " " }}

{{ if .packages.fedora.npm -}}
{{ includeTemplate "npm-tools" . }}
# Install-if-missing only, matching `dnf install` semantics above: upgrades
# are the weekly sweep's job (run_onchange_upgrade-packages), not apply's.
if npm_tier_available; then
{{ range .packages.fedora.npm -}}
	npm_tier_installed {{ . | quote }} || npm_tier_sync {{ . | quote }} || true
{{ end -}}
else
	echo "Warning: npm tier skipped — $NPM_TIER_NODE / $NPM_TIER_NPM missing (expected from dnf)" >&2
fi
{{ end -}}
{{ end -}}
