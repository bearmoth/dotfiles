# Retired gh-copilot extension integration: gh now ships a built-in
# `gh copilot` (delegates to the new standalone Copilot CLI) that shadows
# the deprecated github/gh-copilot extension, so the old shims are dead —
# and fish auto-loads anything left in conf.d/.
.config/gh-copilot
.config/zsh/gh-copilot.sh
.config/fish/conf.d/gh-copilot.fish

# Retired chezmoi alias: it hardcoded ~/.local/bin/chezmoi, which broke on any
# machine where the installer put the binary elsewhere. ~/.local/bin is already
# on PATH (XDG_BIN_HOME in 00-env), so plain PATH lookup replaces the alias.
.config/fish/conf.d/chezmoi.fish

# Retired oh-my-zsh: it loaded no plugins here, so its only jobs were sourcing
# the powerlevel10k theme and setting interactive defaults. The theme now
# installs standalone to .local/share/powerlevel10k and the defaults live in
# .config/zsh/01-shell.sh, so the 12M tree (refreshed weekly from an unpinned
# master) is dead weight. Removing it also drops the theme copy underneath it.
.oh-my-zsh
.config/zsh/oh-my-zsh.sh
