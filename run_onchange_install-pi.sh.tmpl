{{ if eq .osid "linux-fedora" -}}
#!/bin/bash
# pi (coding agent) on Fedora — npm is the package manager (ADR-0011).
#
# Re-run weekly: {{ now.Year }}-W{{ div now.YearDay 7 }}
#
# On macOS pi comes from the homebrew-core formula declared in packages.yaml:
# it is autobumped upstream and rides the weekly `brew upgrade` sweep, so there
# is nothing to script there. Fedora has no usable package — the dist-git
# package exists only on rawhide/main and trails upstream by weeks — so npm is
# the delivery mechanism here. node and npm themselves are declared in
# packages.yaml, which is what gets them installed (run_before_all-02) and
# keeps them upgraded (run_onchange_upgrade-packages).
#
# One script rather than the herdr-style install + update pair: for npm,
# install and upgrade are the same command, so a single idempotent weekly run
# converges whether or not pi is already present.
set -uo pipefail
# No -e: this reaches the network, and a failed weekly upgrade must not abort
# `chezmoi apply` (same reasoning as run_onchange_upgrade-packages).

PI_PACKAGE="@earendil-works/pi-coding-agent"
PI_PREFIX="$HOME/.local/share/pi"

# Deliberately /usr/bin/node, not `command -v node`: the node we want is the
# dnf-managed one, never whichever node a version manager has put on PATH.
NODE=/usr/bin/node
NPM=/usr/bin/npm

if [ ! -x "$NODE" ] || [ ! -x "$NPM" ]; then
	echo "pi: $NODE / $NPM missing — skipping (expected from dnf, see packages.yaml)" >&2
	exit 0
fi

# pi needs node >= 22.19.0. Older node installs fine and then fails at *runtime*
# with an opaque undici TypeError, so refuse up front rather than leave a broken
# `pi` on PATH. (Same check upstream's own installer makes.)
if ! "$NODE" -e 'const [maj,min,patch] = process.versions.node.split(".").map(Number); process.exit(maj > 22 || (maj === 22 && (min > 19 || (min === 19 && patch >= 0))) ? 0 : 1)'; then
	echo "pi: node $("$NODE" --version) is older than v22.19.0 — skipping install" >&2
	exit 0
fi

echo "Installing/upgrading pi..."
# --ignore-scripts mirrors every install command upstream documents.
# --prefix keeps this out of /usr (no sudo) and out of any version manager's
# global prefix, which would evaporate when that node version is pruned.
if ! "$NPM" install -g --ignore-scripts --prefix "$PI_PREFIX" \
	--no-fund --no-audit --loglevel=error "$PI_PACKAGE"; then
	echo "Warning: pi install/upgrade failed (see output above)" >&2
	exit 0
fi

# Pin the interpreter. pi's bin ships `#!/usr/bin/env node`, so a project-local
# nvm switch to an older node would break an otherwise fine install. Homebrew
# solves this by rewriting the shebang to its own node; this wrapper is the
# equivalent, and it leaves everything under $PI_PREFIX owned solely by npm.
mkdir -p "$HOME/.local/bin"
cat >"$HOME/.local/bin/pi" <<EOF
#!/bin/sh
# Generated by chezmoi (run_onchange_install-pi.sh.tmpl) — do not edit.
# Pins pi to the dnf-managed node so a project-switched node cannot break it.
exec $NODE "$PI_PREFIX/lib/node_modules/$PI_PACKAGE/dist/cli.js" "\$@"
EOF
chmod +x "$HOME/.local/bin/pi"
{{ end -}}
