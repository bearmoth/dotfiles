{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- $workHostnames := list "MacBook-Pro" -}}
{{- $isWork := has .chezmoi.hostname $workHostnames -}}

{{- /* Machine-local engineering-os data (mounts, clone/worktree roots) is
       hand-maintained in this config file per machine (wayfinder #9).
       Carry it forward when `chezmoi init` regenerates the config. */ -}}
{{- $eos := dict -}}
{{- if hasKey . "eos" -}}
{{-   $eos = .eos -}}
{{- end -}}

data:
  osid: {{ $osid | quote }}
  isWork: {{ $isWork }}
  {{- /* Declared machine identity (ADR-0009): a human-chosen kebab-case
         slug, prompted once at `chezmoi init` and carried forward on
         re-inits. Never derived from hostname — factory defaults are
         non-unique and macOS mutates hostnames on DHCP collisions. */}}
  machine:
    id: {{ promptStringOnce . "machine.id" "machine id (unique kebab-case slug for this machine, e.g. mbp-work, metabox)" | quote }}
{{- if $eos }}
  eos: {{ toJson $eos }}
{{- end }}
