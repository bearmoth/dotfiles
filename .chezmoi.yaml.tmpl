{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- /* Work machines are declared by machine id (ADR-0009), never hostname:
       factory-default names like "MacBook-Pro" are non-unique and macOS
       mutates hostnames on DHCP collisions. machine.id is prompted at init
       and carried forward from the existing config on re-init. */ -}}
{{- $workMachineIds := list "easygo-laptop" -}}
{{- /* Prompt here (once) so a fresh init has the id before isWork is
       computed; promptStringOnce reuses the existing config's value on
       re-init. */ -}}
{{- $machineId := promptStringOnce . "machine.id" "machine id (unique kebab-case slug for this machine, e.g. mbp-work, metabox)" -}}
{{- $isWork := has $machineId $workMachineIds -}}

{{- /* Machine-local engineering-os data (mounts, clone/worktree roots) is
       hand-maintained in this config file per machine (wayfinder #9).
       Carry it forward when `chezmoi init` regenerates the config. */ -}}
{{- $eos := dict -}}
{{- if hasKey . "eos" -}}
{{-   $eos = .eos -}}
{{- end -}}

data:
  osid: {{ $osid | quote }}
  isWork: {{ $isWork }}
  machine:
    id: {{ $machineId | quote }}
{{- if $eos }}
  eos: {{ toJson $eos }}
{{- end }}
